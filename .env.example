# Copy this file to .env and set your own values.
# .env is never committed to git. This file is.

COMPOSE_PROJECT_NAME=ecommerce_dwh

# --- PostgreSQL ---
POSTGRES_USER=dwh
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=ecommerce

# Host depends on WHERE you connect FROM:
#   localhost - from Windows (DBeaver, Power BI, python)
#   postgres  - from inside docker network (Jupyter, Airflow)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Jupyter ---
JUPYTER_TOKEN=CHANGE_ME